func TestV34CandidateFailureSkipsRemainingAndReplayDoesNotCall(t *testing.T) {
	root := t.TempDir()
	calls := 0
	fake := func(_ context.Context, p agentqualification.ClaudeScreeningPlan) (agentqualification.ProviderExecutionResult, []byte, []byte, time.Duration, bool, error) {
		calls++
		candidate := []byte(`{}`)
		raw := []byte(`{"result":"{}"}`)
		in, out, cost := int64(10), int64(10), int64(1)
		r := agentqualification.ProviderExecutionResult{ObservationID: "obs", ReportedModel: p.Model, ReportedModelVersion: p.Model, ReportedModelVersionStatus: "reported", ReportedServingProvider: "anthropic", ProviderResponseID: "resp", StartedAt: "2026-09-13T12:00:00Z", CompletedAt: "2026-09-13T12:00:01Z", TerminalState: "completed", ObservedProviderEventTypes: []string{"result"}, RawTraceSHA256: hashText(string(raw)), OutputSHA256: hashText(string(candidate)), Usage: agentqualification.ExecutionReceiptUsage{InputTokens: &in, CachedInputTokens: new(int64), OutputTokens: &out, ReasoningTokensStatus: "provider_unavailable", ProviderReportedCostMicros: &cost}}
		return r, candidate, raw, time.Second, true, nil
	}
	l, err := executeV34(context.Background(), root, fake)
	if err != nil {
		t.Fatal(err)
	}
	if calls != 1 || !l.CandidateEliminated || len(l.Claims) != 6 {
		t.Fatalf("calls=%d ledger=%+v", calls, l)
	}
	before, _ := fileHash(filepath.Join(root, "ledger.json"))
	r, err := replayV34(root)
	if err != nil {
		t.Fatal(err)
	}
	after, _ := fileHash(filepath.Join(root, "ledger.json"))
	if before != after || r["provider_called"] != false || calls != 1 {
		t.Fatalf("replay changed evidence/calls")
	}
}

func TestV34ObservationInvalidContinuesAndStrandedClaimClosesWithoutRetry(t *testing.T) {
	root := t.TempDir()
	calls := 0
	fake := func(_ context.Context, _ agentqualification.ClaudeScreeningPlan) (agentqualification.ProviderExecutionResult, []byte, []byte, time.Duration, bool, error) {
		calls++
		return agentqualification.ProviderExecutionResult{}, nil, []byte(`{"aborted":true}`), time.Millisecond, true, failV34(v34ObservationTransport, errors.New("timeout"))
	}
	l, err := executeV34(context.Background(), root, fake)
	if err != nil {
		t.Fatal(err)
	}
	if calls != 6 || l.GlobalHalt || l.Status != "complete" {
		t.Fatalf("calls=%d ledger=%+v", calls, l)
	}
	if l.Usage.ProviderInvocations != 6 || l.Usage.UnknownUsageInvocations != 6 || l.Usage.ConservativeReservedTokens != 90_000 {
		t.Fatalf("failed launches were not truthfully reserved: %+v", l.Usage)
	}
	root2 := t.TempDir()
	d, _ := agentqualification.ClaudeSubscriptionStaticV34()
	l2, _ := loadOrCreateLedger(filepath.Join(root2, "ledger.json"), d)
	b := v34Binding(d.BatchID, 0, d.Cases[0])
	dir := filepath.Join(root2, b)
	if err := os.Mkdir(dir, 0o700); err != nil {
		t.Fatal(err)
	}
	stranded := v34Claim{BindingID: b, CaseID: "T12", CaseVersion: "v4", Status: "pending", UsageStatus: "pending"}
	if err := writeJSONExclusive(filepath.Join(dir, "claim.json"), stranded); err != nil {
		t.Fatal(err)
	}
	plan, err := agentqualification.BuildClaudeSubscriptionScreeningPlan(d.Configuration, d.Cases[0])
	if err != nil {
		t.Fatal(err)
	}
	if err := writeJSONExclusive(filepath.Join(dir, "launch-capsule.json"), expectedV34Capsule(d, b, d.Cases[0], plan)); err != nil {
		t.Fatal(err)
	}
	l2.Claims[b] = stranded
	if err := writeJSONAtomic(filepath.Join(root2, "ledger.json"), l2); err != nil {
		t.Fatal(err)
	}
	l2, err = executeV34(context.Background(), root2, fake)
	if err != nil || calls != 11 || l2.Claims[b].FailureClass != string(v34ObservationTransport) || l2.Claims[b].Usage.UnknownUsageInvocations != 1 {
		t.Fatalf("stranded claim was retried or not conservatively closed: calls=%d ledger=%+v err=%v", calls, l2, err)
	}
}

func TestV34TypedStopsCannotBeSpoofedByErrorText(t *testing.T) {
	if kind, ok := kindV34(errors.New("authentication credential unsafe budget")); ok || kind != "" {
		t.Fatal("untyped error text was classified")
	}
	if kind, ok := kindV34(failV34(v34ObservationTransport, errors.New("authentication words are irrelevant"))); !ok || kind != v34ObservationTransport {
		t.Fatal("typed local transport failure was changed by its text")
	}
}

func TestV34CredentialAndCampaignCapAreGlobal(t *testing.T) {
	if kind, ok := kindV34(failV34(v34CredentialFailure, errors.New("denied"))); !ok || kind != v34CredentialFailure {
		t.Fatal("typed credential failure not preserved")
	}
	d, _ := agentqualification.ClaudeSubscriptionStaticV34()
	l := v34Ledger{SchemaVersion: "silver-mediums.claude-subscription-static-ledger.v34", BatchID: d.BatchID, DefinitionSHA256: agentqualification.ClaudeSubscriptionStaticV34SHA256(), FreezeSHA256: agentqualification.ClaudeSubscriptionStaticV34FreezeSHA256(), Status: "active", Claims: map[string]v34Claim{}, Usage: v34Usage{InputTokens: 89999}}
	root := t.TempDir()
	if err := writeJSONExclusive(filepath.Join(root, "ledger.json"), l); err != nil {
		t.Fatal(err)
	}
	called := false
	_, err := executeV34(context.Background(), root, func(context.Context, agentqualification.ClaudeScreeningPlan) (agentqualification.ProviderExecutionResult, []byte, []byte, time.Duration, bool, error) {
		called = true
		return agentqualification.ProviderExecutionResult{}, nil, nil, 0, false, nil
	})
	if err == nil || called {
		t.Fatal("campaign admission overshot")
	}
}

func TestV34TypedGlobalFailureStopsAfterOneAndAccountsLaunch(t *testing.T) {
	for _, kind := range []v34FailureKind{v34CredentialFailure, v34UnsafeExternal, v34EvidenceCorruption, v34CampaignCap} {
		t.Run(string(kind), func(t *testing.T) {
			calls := 0
			ledger, err := executeV34(context.Background(), t.TempDir(), func(context.Context, agentqualification.ClaudeScreeningPlan) (agentqualification.ProviderExecutionResult, []byte, []byte, time.Duration, bool, error) {
				calls++
				return agentqualification.ProviderExecutionResult{}, nil, []byte(`{"terminal":"failed"}`), time.Second, true, failV34(kind, errors.New("fixture"))
			})
			if err == nil || calls != 1 || !ledger.GlobalHalt || ledger.Usage.ProviderInvocations != 1 || ledger.Usage.UnknownUsageInvocations != 1 || ledger.Usage.ConservativeReservedTokens != 15_000 {
				t.Fatalf("typed global stop/accounting drift: calls=%d ledger=%+v err=%v", calls, ledger, err)
			}
		})
	}
}

