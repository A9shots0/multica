	})

	if _, err := conn.Exec(ctx, `
		CREATE TABLE workspace (id UUID PRIMARY KEY);
		CREATE TABLE issue (id UUID PRIMARY KEY, workspace_id UUID NOT NULL);
		CREATE TABLE squad (id UUID PRIMARY KEY, workspace_id UUID, archived_at TIMESTAMPTZ);
		CREATE TABLE agent (id UUID PRIMARY KEY, workspace_id UUID, archived_at TIMESTAMPTZ);
		CREATE TABLE squad_workflow_template (
			squad_id UUID PRIMARY KEY CONSTRAINT squad_workflow_template_squad_id_fkey REFERENCES squad(id) ON DELETE CASCADE,
			workspace_id UUID NOT NULL CONSTRAINT squad_workflow_template_workspace_id_fkey REFERENCES workspace(id) ON DELETE CASCADE,
			implementer_id UUID NOT NULL CONSTRAINT squad_workflow_template_implementer_id_fkey REFERENCES agent(id),
			reviewer_id UUID NOT NULL CONSTRAINT squad_workflow_template_reviewer_id_fkey REFERENCES agent(id),
			release_agent_id UUID CONSTRAINT squad_workflow_template_release_agent_id_fkey REFERENCES agent(id),
			verifier_id UUID CONSTRAINT squad_workflow_template_verifier_id_fkey REFERENCES agent(id),
			requires_owner BOOLEAN NOT NULL DEFAULT FALSE, requires_deployment BOOLEAN NOT NULL DEFAULT FALSE,
			max_corrections INTEGER NOT NULL DEFAULT 1, created_at TIMESTAMPTZ NOT NULL DEFAULT now(), updated_at TIMESTAMPTZ NOT NULL DEFAULT now()
		);
		CREATE INDEX squad_workflow_template_workspace_idx ON squad_workflow_template(workspace_id);
	`); err != nil {
		t.Fatal(err)
	}
	applySQLFile(t, ctx, conn, filepath.Join("..", "..", "migrations", "466_issue_workflow_v2_records.up.sql"))
	applySQLFile(t, ctx, conn, filepath.Join("..", "..", "migrations", "482_issue_current_picture_key_idx.up.sql"))

	workspaceID, issueID := testUUID(1), testUUID(2)
	if _, err := conn.Exec(ctx, `INSERT INTO workspace(id) VALUES($1)`, workspaceID); err != nil {
		t.Fatal(err)
	}
	if _, err := conn.Exec(ctx, `INSERT INTO issue(id, workspace_id) VALUES($1, $2)`, issueID, workspaceID); err != nil {
		t.Fatal(err)
	}
	if _, err := conn.Exec(ctx, `INSERT INTO issue_workflow_outcome(id, workspace_id, issue_id, state, acceptance_version) VALUES($1, $2, $3, 'open', 1)`, testUUID(3), workspaceID, issueID); err != nil {
		t.Fatal(err)
	}
	queries := db.New(conn)
	base := time.Date(2026, 9, 10, 12, 0, 0, 0, time.UTC)
	if _, err := ProjectAndStore(ctx, conn, queries, workspaceID, issueID, 1, 1, base); !errors.Is(err, pgx.ErrNoRows) {
		t.Fatalf("nonzero initial expected revision error = %v, want pgx.ErrNoRows", err)
	}
	if _, err := queries.GetIssueCurrentPicture(ctx, db.GetIssueCurrentPictureParams{WorkspaceID: workspaceID, IssueID: issueID}); !errors.Is(err, pgx.ErrNoRows) {
		t.Fatalf("nonzero initial expected revision created picture: %v", err)
	}

	otherWorkspaceID, otherIssueID := testUUID(10), testUUID(11)
	if _, err := conn.Exec(ctx, `INSERT INTO workspace(id) VALUES($1)`, otherWorkspaceID); err != nil {
		t.Fatal(err)
	}
	if _, err := conn.Exec(ctx, `INSERT INTO issue(id, workspace_id) VALUES($1, $2)`, otherIssueID, otherWorkspaceID); err != nil {
		t.Fatal(err)
	}
	if _, err := conn.Exec(ctx, `INSERT INTO issue_workflow_outcome(id, workspace_id, issue_id, state, acceptance_version) VALUES($1, $2, $3, 'satisfied', 9)`, testUUID(12), otherWorkspaceID, otherIssueID); err != nil {
		t.Fatal(err)
	}
	if _, err := ProjectAndStore(ctx, conn, queries, otherWorkspaceID, issueID, 0, 1, base); !errors.Is(err, pgx.ErrNoRows) {
		t.Fatalf("cross-tenant issue admission error = %v, want pgx.ErrNoRows", err)
	}

	first, err := ProjectAndStore(ctx, conn, queries, workspaceID, issueID, 0, 1, base)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := queries.DeleteIssueCurrentPictureForRebuild(ctx, db.DeleteIssueCurrentPictureForRebuildParams{WorkspaceID: workspaceID, IssueID: issueID}); err != nil {
		t.Fatal(err)
	}
	rebuilt, err := ProjectAndStore(ctx, conn, queries, workspaceID, issueID, 0, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if !bytes.Equal(first.Document, rebuilt.Document) || !bytes.Equal(first.SourceRevisions, rebuilt.SourceRevisions) {
		t.Fatalf("rebuild changed semantic bytes\nfirst=%s\nrebuilt=%s", first.Document, rebuilt.Document)
	}
	if _, err := ProjectAndStore(ctx, conn, queries, workspaceID, issueID, 0, 2, base.Add(2*time.Hour)); !errors.Is(err, pgx.ErrNoRows) {
		t.Fatalf("stale CAS error = %v, want pgx.ErrNoRows", err)
	}
	updated, err := ProjectAndStore(ctx, conn, queries, workspaceID, issueID, 1, 2, base.Add(2*time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if updated.Revision != 2 {
		t.Fatalf("updated revision = %d, want 2", updated.Revision)
	}

	rows, err := queries.ListIssueWorkflowProjectionInputs(ctx, db.ListIssueWorkflowProjectionInputsParams{WorkspaceID: workspaceID, IssueID: issueID})
	if err != nil {
		t.Fatal(err)
	}
	records := make([]Record, 0, len(rows))
	for _, row := range rows {
		records = append(records, Record{Type: row.RecordType, ID: uuidString(row.ID), Revision: row.Revision, CreatedAt: row.CreatedAt.Time.UTC(), Payload: row.Payload})
	}
	if len(records) != 1 || records[0].ID != uuidString(testUUID(3)) {
		t.Fatalf("tenant-isolated source records = %#v", records)
	}
	rollbackProjection, err := Project(records, 3, base.Add(3*time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	rollbackErr := errors.New("force rollback after projection write")
	err = workflowstore.InIssueWriteTransaction(ctx, conn, queries, workspaceID, issueID, func(write *workflowstore.IssueWrite) error {
		if _, err := write.UpsertCurrentPictureCAS(ctx, rollbackProjection.params(workspaceID, issueID, 2)); err != nil {
			return err
		}
		return rollbackErr
	})
	if !errors.Is(err, rollbackErr) {
		t.Fatalf("rollback transaction error = %v, want sentinel", err)
	}
	afterRollback, err := queries.GetIssueCurrentPicture(ctx, db.GetIssueCurrentPictureParams{WorkspaceID: workspaceID, IssueID: issueID})
	if err != nil {
		t.Fatal(err)
	}
	if afterRollback.Revision != 2 || !bytes.Equal(afterRollback.Document, updated.Document) {
		t.Fatalf("partial write escaped rollback: revision=%d document=%s", afterRollback.Revision, afterRollback.Document)
	}
}

