func TestProjectHealthRequiresExactCurrentReleaseEvidence(t *testing.T) {
	base := time.Date(2026, 9, 10, 12, 0, 0, 0, time.UTC)
	baseRecords := []Record{
		fixture("scope", "00000000-0000-0000-0000-000000000031", 3, base, map[string]any{"state": "accepted", "acceptance_version": 4}),
		fixture("authority", "authority-1", 2, base, map[string]any{"scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3}),
		fixture("candidate", "candidate-1", 2, base, map[string]any{"scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3}),
		fixture("execution", "execution-1", 1, base, map[string]any{"scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3, "authority_id": "authority-1", "authority_revision": 2, "candidate_id": "candidate-1", "target_key": "production"}),
		fixture("release", "00000000-0000-0000-0000-000000000032", 6, base.Add(time.Minute), map[string]any{"state": "live", "candidate_id": "candidate-1", "candidate_revision": 2, "scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3, "authority_id": "authority-1", "authority_revision": 2, "target_key": "production", "target_generation": 9, "release_operator_id": "operator-1", "planned_verifier_id": "verifier-1"}),
		fixture("target_head", "00000000-0000-0000-0000-000000000032", 3, base.Add(time.Minute), map[string]any{"release_id": "00000000-0000-0000-0000-000000000032", "issue_id": "issue-1", "candidate_id": "candidate-1", "target_key": "production", "generation": 9, "state": "live"}),
	}
	evidence := func(id, evidenceType string, acceptanceVersion int64) Record {
		return fixture("evidence", id, 1, base.Add(2*time.Minute), map[string]any{
			"evidence_type": evidenceType, "level": evidenceType, "producer_id": "verifier-1", "candidate_id": "candidate-1",
			"target_key": "production", "contradictions": []any{},
			"payload": map[string]any{"candidate_revision": 2, "release_id": "00000000-0000-0000-0000-000000000032", "target_generation": 9, "acceptance_version": acceptanceVersion, "scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3, "freshness": "current"},
		})
	}

	complete := append(append([]Record(nil), baseRecords...),
		evidence("00000000-0000-0000-0000-000000000033", "runtime", 4),
		evidence("00000000-0000-0000-0000-000000000034", "business", 4),
		evidence("00000000-0000-0000-0000-000000000038", "regression", 4),
	)
	projection, err := Project(complete, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if projection.ReleaseState != "live" || projection.HealthState != "healthy" {
		t.Fatalf("exact proof produced release/health %q/%q, want live/healthy", projection.ReleaseState, projection.HealthState)
	}

	staleAcceptance := append(append([]Record(nil), baseRecords...),
		evidence("00000000-0000-0000-0000-000000000035", "runtime", 3),
		evidence("00000000-0000-0000-0000-000000000036", "business", 4),
	)
	projection, err = Project(staleAcceptance, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if projection.HealthState != "unverified" || projection.ReleaseState == "live" || projection.CurrentMilestone == "live" {
		t.Fatalf("stale acceptance evidence leaked live: release=%q health=%q milestone=%q", projection.ReleaseState, projection.HealthState, projection.CurrentMilestone)
	}
	var staleDocument Document
	if err := json.Unmarshal(projection.Document, &staleDocument); err != nil || staleDocument.Release["state"] != projection.ReleaseState {
		t.Fatalf("document/top-level release state diverged: document=%#v top=%q err=%v", staleDocument.Release["state"], projection.ReleaseState, err)
	}

	wrongProducer := append([]Record(nil), complete...)
	wrongProducer[6] = evidence("00000000-0000-0000-0000-000000000033", "runtime", 4)
	var wrongFields map[string]any
	_ = json.Unmarshal(wrongProducer[6].Payload, &wrongFields)
	wrongFields["producer_id"] = "other-verifier"
	wrongProducer[6].Payload, _ = json.Marshal(wrongFields)
	projection, err = Project(wrongProducer, 1, base.Add(time.Hour))
	if err != nil || projection.HealthState != "unverified" || projection.ReleaseState == "live" {
		t.Fatalf("wrong verifier leaked live: release=%q health=%q err=%v", projection.ReleaseState, projection.HealthState, err)
	}

	for _, tc := range []struct {
		name, field, value string
	}{{"operator disagreement", "release_operator_id", "other-operator"}, {"verifier disagreement", "planned_verifier_id", "other-verifier"}} {
		t.Run(tc.name, func(t *testing.T) {
			conflicting := append([]Record(nil), complete...)
			var releaseFields map[string]any
			if err := json.Unmarshal(conflicting[4].Payload, &releaseFields); err != nil {
				t.Fatal(err)
			}
			releaseFields["facets"] = map[string]any{tc.field: tc.value}
			conflicting[4].Payload, _ = json.Marshal(releaseFields)
			got, err := Project(conflicting, 1, base.Add(time.Hour))
			if err != nil {
				t.Fatal(err)
			}
			var document Document
			if err := json.Unmarshal(got.Document, &document); err != nil {
				t.Fatal(err)
			}
			if got.HealthState != "unverified" || got.ReleaseState == "live" || got.CurrentMilestone == "live" || document.Release["state"] != got.ReleaseState {
				t.Fatalf("identity disagreement leaked live: release=%q health=%q milestone=%q document=%#v", got.ReleaseState, got.HealthState, got.CurrentMilestone, document.Release)
			}
		})
	}

	staleHead := append([]Record(nil), complete...)
	staleHead[5] = fixture("target_head", "old-release", 1, base.Add(time.Minute), map[string]any{"release_id": "old-release", "candidate_id": "candidate-1", "target_key": "production", "generation": 9})
	projection, err = Project(staleHead, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if projection.HealthState != "unverified" || projection.ReleaseState == "live" || projection.CurrentMilestone == "live" {
		t.Fatalf("stale target head leaked live: release=%q health=%q milestone=%q", projection.ReleaseState, projection.HealthState, projection.CurrentMilestone)
	}

	staleReleaseProof := append([]Record(nil), complete...)
	staleReleaseProof[6] = evidence("00000000-0000-0000-0000-000000000037", "runtime", 4)
	var staleFields map[string]any
	if err := json.Unmarshal(staleReleaseProof[6].Payload, &staleFields); err != nil {
		t.Fatal(err)
	}
	staleFields["payload"].(map[string]any)["release_id"] = "old-release"
	staleReleaseProof[6].Payload, _ = json.Marshal(staleFields)
	projection, err = Project(staleReleaseProof, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if projection.HealthState != "unverified" {
		t.Fatalf("stale release evidence produced health %q, want unverified", projection.HealthState)
	}

	deployed := append([]Record(nil), complete...)
	deployed[4] = fixture("release", "00000000-0000-0000-0000-000000000032", 6, base.Add(time.Minute), map[string]any{"state": "deployed", "candidate_id": "candidate-1", "candidate_revision": 2, "scope_id": "00000000-0000-0000-0000-000000000031", "scope_revision": 3, "authority_id": "authority-1", "authority_revision": 2, "target_key": "production", "target_generation": 9})
	projection, err = Project(deployed, 1, base.Add(time.Hour))
	if err != nil {
		t.Fatal(err)
	}
	if projection.ReleaseState != "deployed" || projection.HealthState != "verifying" {
		t.Fatalf("deployment produced release/health %q/%q, want deployed/verifying", projection.ReleaseState, projection.HealthState)
	}
}

