	defaults := map[string]map[string]any{
		"outcome":           {"state": "open", "acceptance_version": 1},
		"scope":             {"state": "accepted", "acceptance_version": 1, "owner_evidence_id": "owner-evidence", "created_by": "owner", "statement": map[string]any{}, "impact": map[string]any{}},
		"authority":         {"state": "active", "scope_id": "scope", "scope_revision": 1, "owner_evidence_id": "owner-evidence", "created_by": "owner", "envelope": map[string]any{}},
		"execution":         {"branch_key": "main", "operation_type": "implementation", "state": "received", "scope_id": "scope", "scope_revision": 1, "authority_revision": 1, "checkpoint": map[string]any{}, "expected_event": map[string]any{}, "wait_reason": map[string]any{}, "attempt_count": 0},
		"decision":          {"decision_type": "approval", "state": "unanswered", "resolution_state": "open", "question": "Proceed?", "options": []any{}, "requester_id": "requester", "accountable_owner_id": "owner", "suspended_operation_id": "operation"},
		"decision_response": {"decision_id": "decision", "decision_revision": 1, "response_type": "approve", "actor_id": "owner", "idempotency_key": "key", "request_hash": "hash", "selected_options": []any{}, "content": map[string]any{}, "scope_change": map[string]any{}},
		"candidate":         {"scope_id": "scope", "scope_revision": 1, "candidate_type": "source", "state": "ready", "artifact": map[string]any{}, "build_contract": map[string]any{}, "created_by": "agent"},
		"review":            {"candidate_id": "candidate", "candidate_revision": 1, "scope_id": "scope", "scope_revision": 1, "reviewer_id": "reviewer", "outcome": "passed", "criteria": []any{}, "coverage": map[string]any{}, "evidence_refs": []any{}, "gaps": []any{}, "correction_packet": map[string]any{}, "correction_count": 0, "max_corrections": 0},
		"release":           {"candidate_id": "candidate", "candidate_revision": 1, "scope_id": "scope", "scope_revision": 1, "authority_id": "authority", "authority_revision": 1, "target_key": "production", "target_generation": 1, "state": "pending", "facets": map[string]any{}, "recovery_policy": map[string]any{}, "exposed_population": map[string]any{}},
		"evidence":          {"evidence_type": "other", "level": "local", "source": "test", "producer_type": "verifier", "observed_at": createdAt.Format(time.RFC3339Nano), "coverage": map[string]any{}, "limitations": []any{}, "contradictions": []any{}, "payload": map[string]any{}},
		"incident":          {"incident_type": "regression", "severity": "warning", "state": "open", "consequence": map[string]any{}, "recovery": map[string]any{}},
		"action_receipt":    {"action_key": "action", "request_hash": "hash", "command_id": "command", "action_type": "dispatch", "state": "admitted", "payload": map[string]any{}, "attempt_count": 0, "max_attempts": 1},
		"attention":         {"attention_type": "decision", "read_state": "unread", "resolution_state": "open", "context": map[string]any{}, "next_action": map[string]any{}},
		"budget":            {"scope_id": "scope", "concern_type": "execution", "state": "active", "limits": map[string]any{}, "consumption": map[string]any{}},
		"target_head":       {"target_key": "production", "generation": 1, "release_id": id, "issue_id": "issue", "candidate_id": "candidate", "state": "pending"},
	}
	merged := cloneMap(defaults[recordType])
	for key, value := range fields {
		merged[key] = value
	}
	fields = merged
	fields["id"] = id
	fields["revision"] = revision
	fields["created_at"] = createdAt.Format(time.RFC3339Nano)
	if recordType == "target_head" {
		fields["updated_at"] = createdAt.Format(time.RFC3339Nano)
	}
	payload, err := json.Marshal(fields)
	if err != nil {
		panic(err)
	}
	return Record{Type: recordType, ID: id, Revision: revision, CreatedAt: createdAt, Payload: payload}
}

func applySQLFile(t *testing.T, ctx context.Context, conn *pgx.Conn, path string) {
	t.Helper()
	body, err := os.ReadFile(path)
	if err != nil {
		t.Fatal(err)
	}
	if _, err := conn.Exec(ctx, string(body)); err != nil {
		t.Fatalf("apply %s: %v", path, err)
	}
}

func testUUID(last byte) pgtype.UUID {
	var value [16]byte
	value[15] = last
	return pgtype.UUID{Bytes: value, Valid: true}
}
