func TestProjectDeterministicCompleteCurrentPicture(t *testing.T) {
	base := time.Date(2026, 9, 10, 12, 0, 0, 0, time.UTC)
	records := []Record{
		fixture("outcome", "00000000-0000-0000-0000-000000000001", 2, base, map[string]any{"state": "open", "acceptance_version": 3}),
		fixture("scope", "00000000-0000-0000-0000-000000000002", 3, base.Add(time.Minute), map[string]any{"state": "accepted", "acceptance_version": 3, "statement": map[string]any{"goal": "ship"}}),
		fixture("authority", "00000000-0000-0000-0000-000000000003", 4, base.Add(2*time.Minute), map[string]any{"state": "active", "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "envelope": map[string]any{"deploy": true}}),
		fixture("execution", "00000000-0000-0000-0000-000000000004", 5, base.Add(3*time.Minute), map[string]any{"state": "blocked_external", "branch_key": "main", "operation_type": "release", "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "authority_id": "00000000-0000-0000-0000-000000000003", "authority_revision": 4, "candidate_id": "00000000-0000-0000-0000-000000000005", "target_key": "production", "actor_type": "agent", "actor_id": "agent-1", "expected_event": map[string]any{"type": "provider_readback"}, "wait_reason": map[string]any{"code": "provider"}, "next_action_at": base.Add(time.Hour).Format(time.RFC3339Nano)}),
		fixture("candidate", "00000000-0000-0000-0000-000000000005", 2, base.Add(4*time.Minute), map[string]any{"state": "ready", "candidate_type": "source", "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "source_revision": "abc123"}),
		fixture("candidate", "00000000-0000-0000-0000-000000000006", 1, base.Add(-time.Minute), map[string]any{"state": "ready", "superseded_at": base.Format(time.RFC3339Nano)}),
		fixture("release", "00000000-0000-0000-0000-000000000007", 6, base.Add(5*time.Minute), map[string]any{"state": "deployed", "candidate_id": "00000000-0000-0000-0000-000000000005", "candidate_revision": 2, "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "authority_id": "00000000-0000-0000-0000-000000000003", "authority_revision": 4, "target_key": "production", "target_generation": 7}),
		fixture("target_head", "00000000-0000-0000-0000-000000000007", 7, base.Add(6*time.Minute), map[string]any{"release_id": "00000000-0000-0000-0000-000000000007", "issue_id": "issue-1", "state": "deployed", "target_key": "production", "generation": 7, "candidate_id": "00000000-0000-0000-0000-000000000005"}),
		fixture("evidence", "00000000-0000-0000-0000-000000000009", 1, base.Add(7*time.Minute), map[string]any{"evidence_type": "runtime", "level": "runtime", "source": "provider", "producer_type": "verifier", "observed_at": base.Add(7 * time.Minute).Format(time.RFC3339Nano), "coverage": map[string]any{"region": "all"}, "limitations": []any{"synthetic"}, "candidate_id": "00000000-0000-0000-0000-000000000005", "target_key": "production", "contradictions": []any{}, "payload": map[string]any{"candidate_revision": 2, "release_id": "00000000-0000-0000-0000-000000000007", "target_generation": 7, "acceptance_version": 3, "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "freshness": "current"}}),
		fixture("review", "00000000-0000-0000-0000-000000000014", 1, base.Add(7*time.Minute), map[string]any{"candidate_id": "00000000-0000-0000-0000-000000000005", "candidate_revision": 2, "scope_id": "00000000-0000-0000-0000-000000000002", "scope_revision": 3, "reviewer_id": "reviewer-1", "outcome": "passed", "coverage": map[string]any{"tests": "focused"}}),
		fixture("decision", "00000000-0000-0000-0000-000000000010", 1, base.Add(8*time.Minute), map[string]any{"state": "unanswered", "decision_type": "approval", "question": "Proceed?", "accountable_owner_id": "owner-1"}),
		fixture("incident", "00000000-0000-0000-0000-000000000011", 1, base.Add(9*time.Minute), map[string]any{"state": "open", "release_id": "00000000-0000-0000-0000-000000000007", "target_key": "production", "incident_type": "readback_gap", "severity": "warning"}),
		fixture("attention", "00000000-0000-0000-0000-000000000012", 1, base.Add(10*time.Minute), map[string]any{"attention_type": "decision", "resolution_state": "open", "next_action": map[string]any{"type": "answer"}}),
		fixture("budget", "00000000-0000-0000-0000-000000000013", 1, base.Add(11*time.Minute), map[string]any{"state": "active", "concern_type": "execution", "limits": map[string]any{"attempts": 3}}),
		fixture("action_receipt", "00000000-0000-0000-0000-000000000015", 1, base.Add(12*time.Minute), map[string]any{}),
	}

	first, err := Project(records, 1, base.Add(12*time.Minute))
	if err != nil {
		t.Fatal(err)
	}
	reversed := append([]Record(nil), records...)
	for left, right := 0, len(reversed)-1; left < right; left, right = left+1, right-1 {
		reversed[left], reversed[right] = reversed[right], reversed[left]
	}
	second, err := Project(reversed, 99, base.Add(12*time.Minute))
	if err != nil {
		t.Fatal(err)
	}
	if !SemanticEqual(first, second) {
		t.Fatalf("rebuild semantic bytes differ\nfirst document: %s\nsecond document: %s\nfirst sources: %s\nsecond sources: %s", first.Document, second.Document, first.SourceRevisions, second.SourceRevisions)
	}
	if first.ReleaseState != "deployed" || first.ReleaseState == "live" {
		t.Fatalf("release state = %q, want deployed without inferred live", first.ReleaseState)
	}
	if first.HealthState != "verifying" || first.AttentionState != "open" || first.CurrentMilestone != "needs_attention" {
		t.Fatalf("states = health %q attention %q milestone %q", first.HealthState, first.AttentionState, first.CurrentMilestone)
	}
	if first.ScopeRevision == nil || *first.ScopeRevision != 3 || first.AuthorityRevision == nil || *first.AuthorityRevision != 4 {
		t.Fatalf("scope/authority revisions = %v/%v, want 3/4", first.ScopeRevision, first.AuthorityRevision)
	}

	var document Document
	if err := json.Unmarshal(first.Document, &document); err != nil {
		t.Fatal(err)
	}
	if len(document.UnresolvedDecisions) != 1 || len(document.UnresolvedIncidents) != 1 || len(document.UnresolvedDependencies) != 1 || len(document.Budgets) != 1 {
		t.Fatalf("unresolved/budget cardinalities = %d/%d/%d/%d, want all 1", len(document.UnresolvedDecisions), len(document.UnresolvedIncidents), len(document.UnresolvedDependencies), len(document.Budgets))
	}
	if document.EvidenceSummary["runtime_current"] != false || document.EvidenceSummary["business_current"] != false {
		t.Fatalf("evidence summary = %#v", document.EvidenceSummary)
	}
	if len(document.EvidenceSummary["items"].([]any)) != 1 || len(document.EvidenceSummary["technical_reviews"].([]any)) != 1 {
		t.Fatalf("evidence detail = %#v", document.EvidenceSummary)
	}
	if document.NextActor["type"] != "owner" || document.TerminalReason != "" || document.LatestMeaningfulChange["record_type"] != "incident" {
		t.Fatalf("next actor/terminal/latest = %#v/%q/%#v", document.NextActor, document.TerminalReason, document.LatestMeaningfulChange)
	}
	if document.OriginalBusinessRequest["available"] != false || document.OriginalBusinessRequest["reason"] != "owner_request_evidence_unavailable" {
		t.Fatalf("original request = %#v, want explicit unavailable", document.OriginalBusinessRequest)
	}
	if document.Supersession["total"] != float64(1) {
		t.Fatalf("supersession = %#v", document.Supersession)
	}
}

func TestProjectEmitsV3OnlyForCompleteAuthoritativeReleaseTruth(t *testing.T) {
	base := time.Date(2026, 9, 10, 12, 0, 0, 0, time.UTC)
	records := []Record{
		fixture("outcome", "outcome-v3", 1, base, map[string]any{"state": "open"}),
		fixture("scope", "scope-v3", 1, base, map[string]any{"requires_deployment": true}),
		fixture("authority", "authority-v3", 1, base, map[string]any{"scope_id": "scope-v3", "scope_revision": 1}),
		fixture("candidate", "candidate-v3", 1, base, map[string]any{"scope_id": "scope-v3", "scope_revision": 1, "source_revision": "source-sha"}),
		fixture("execution", "execution-v3", 1, base, map[string]any{"state": "waiting_automatic", "scope_id": "scope-v3", "scope_revision": 1, "authority_id": "authority-v3", "authority_revision": 1, "candidate_id": "candidate-v3", "target_key": "production", "next_action_at": base.Add(time.Hour).Format(time.RFC3339Nano), "expected_event": map[string]any{"type": "deploy_exact_release"}}),
		fixture("release", "release-v3", 2, base, map[string]any{
			"attempt_contract_version": 3, "state": "authorized", "candidate_id": "candidate-v3", "candidate_revision": 1,
			"scope_id": "scope-v3", "scope_revision": 1, "authority_id": "authority-v3", "authority_revision": 1,
			"target_key": "production", "target_generation": 1, "acceptance_version": 1, "operation_id": "operation-v3", "branch_key": "main",
			"expected_target_release_id": "", "expected_target_generation": 0, "release_kind": "forward", "recovery_of_release_id": "",
			"release_operator_id": "operator-v3", "planned_verifier_id": "verifier-v3", "build_manifest_digest": "build-sha",
			"artifact_digest": "artifact-sha", "runtime_contract_digest": "runtime-sha", "authority_capability": "deploy_exact_release",
			"authority_evidence_id": "owner-proof", "recovery_policy_revision": 1, "authority_envelope_digest": "authority-sha",
			"owner_evidence_revision": 1, "exposure_policy_digest": "exposure-sha", "rollback_target_release_id": "",
			"irreversible_effects_digest": "irreversible-sha", "reviewed_review_id": "review-v3", "reviewed_review_revision": 1,
		}),
	}
	projection, err := Project(records, 9, base)
	if err != nil {
		t.Fatal(err)
	}
	if projection.ContractVersion != 3 {
		t.Fatalf("contract version = %d, want 3: %s", projection.ContractVersion, projection.Document)
	}
	var document Document
	if err := json.Unmarshal(projection.Document, &document); err != nil {
		t.Fatal(err)
	}
	if document.ReleaseStatus == nil || document.ReleaseStatus.Phase != "releasing" || !ValidReleaseStatusDocument(projection.Document) {
		t.Fatalf("release status = %#v", document.ReleaseStatus)
	}
	if projection.CurrentMilestone != "releasing" || document.CurrentMilestone != "releasing" {
		t.Fatalf("v3 milestone = projection %q document %q, want typed phase releasing", projection.CurrentMilestone, document.CurrentMilestone)
	}
	if summary := OwnerIssueSummaryFromDocument(projection.Document, projection.Revision, projection.GeneratedAt); summary.Stage != OwnerStageReleasing {
		t.Fatalf("owner summary = %#v, want releasing", summary)
	}

	var fields map[string]any
	if err := json.Unmarshal(records[len(records)-1].Payload, &fields); err != nil {
		t.Fatal(err)
	}
	delete(fields, "artifact_digest")
	records[len(records)-1].Payload, _ = json.Marshal(fields)
	if _, err := Project(records, 10, base); err == nil {
		t.Fatal("incomplete v3 release snapshot was accepted")
	}
}

func TestExactDeploymentReceiptRequiresImmutableApplicableProviderIdentity(t *testing.T) {
	fresh := map[string]any{"current": true}
	if got := exactDeploymentReceipt(map[string]any{"items": []map[string]any{{
		"evidence_type": "deployment", "applies": true, "freshness": fresh,
		"observed_at": "2026-09-10T12:00:00Z",
	}}}); got != nil {
		t.Fatalf("timestamp-only evidence produced deployed revision %q", *got)
	}

	if got := exactDeploymentReceipt(map[string]any{"items": []map[string]any{{
		"evidence_type": "deployment", "applies": true, "freshness": fresh,
		"provider_receipt_id": "provider-revision-7",
	}}}); got == nil || *got != "provider-revision-7" {
		t.Fatalf("exact provider receipt = %v, want provider-revision-7", got)
	}

	if got := exactDeploymentReceipt(map[string]any{"items": []map[string]any{
		{"evidence_type": "deployment", "applies": true, "provider_receipt_id": "provider-revision-7"},
		{"evidence_type": "deployment", "applies": true, "provider_receipt_id": "provider-revision-8"},
	}}); got != nil {
		t.Fatalf("conflicting provider receipts produced deployed revision %q", *got)
	}
}

