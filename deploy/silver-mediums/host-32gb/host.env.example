# Copy this file outside the repository to:
#   ~/.config/silver-mediums/multica/host.env
# Then run: chmod 600 ~/.config/silver-mediums/multica/host.env

COMPOSE_PROJECT_NAME=multica
MULTICA_BACKEND_IMAGE=sha256:59229cb8c665c75b334b1c5dee0cdacfb9370a181e5b0d9fb2dd561f8dd6cc60
MULTICA_WEB_IMAGE=sha256:b1fa0575c44d441ddd3088d547c6b562f2a55f70c138264d9598d48bc3c59547
MULTICA_POSTGRES_IMAGE=sha256:cf134a767f474095eeba57e0117be8e568e011a63f33fbf252f14c9b760f8e6f

POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=replace-with-a-new-random-value
JWT_SECRET=replace-with-a-new-random-value

BACKEND_PORT=8080
FRONTEND_PORT=3000
MULTICA_PGDATA_VOLUME=multica_pgdata
MULTICA_UPLOADS_VOLUME=multica_backend_uploads
MULTICA_RECOVERY_STATE_PATH=/Users/a32/.silver-mediums/multica/recovery/state
MULTICA_DATA_READY_RECEIPT=/Users/a32/.silver-mediums/multica/recovery/receipts/production-data-ready.json
MULTICA_FEATURE_FLAGS_PATH=/Users/a32/.config/silver-mediums/multica/feature-flags.yml

FRONTEND_ORIGIN=https://32s-mac-mini.tailda9924.ts.net
CORS_ALLOWED_ORIGINS=https://32s-mac-mini.tailda9924.ts.net
MULTICA_APP_URL=https://32s-mac-mini.tailda9924.ts.net
MULTICA_DAEMON_SERVER_URL=https://32s-mac-mini.tailda9924.ts.net
LOCAL_UPLOAD_BASE_URL=https://32s-mac-mini.tailda9924.ts.net

ALLOW_SIGNUP=false
DISABLE_WORKSPACE_CREATION=true
# Tailnet-only fixed-code login. Keep the code only in the protected host.env;
# the frontend receives only the boolean mode from /api/config.
MULTICA_PRIVATE_ACCESS_CODE_LOGIN=false
MULTICA_PRIVATE_ACCESS_CODE=
# Keep disabled unless this private host intentionally enables reviewed Plugin
# and Outcome Receipt integrations.
FF_PLUGINS_V1=false
# Continuous-work rollout is owned by the protected feature-flags.yml. Keep
# observation and checkpoint targeted there; do not add global FF_* overrides.
MULTICA_OWNER_SMS_MODE=off
MULTICA_LLM_MAX_RETRIES=0
MULTICA_LLM_BASE_URL=
MULTICA_LLM_DEFAULT_MODEL=
# Server-side only. When Intelligence runs directly on this Mac, use its
# host.docker.internal URL; never copy these credentials into daemon config.
MULTICA_INTELLIGENCE_BASE_URL=
MULTICA_INTELLIGENCE_WRITER_TOKEN=replace-with-intelligence-multica-writer-token
MULTICA_INTELLIGENCE_READER_TOKEN=replace-with-intelligence-multica-reader-token
MULTICA_VCS_INTEGRATION_ENABLED=false
# Keep dispatch paused for the first cutover start. Enable it only after the
# remote coding workers have been reconnected and checked.
MULTICA_WORKFLOW_DRIVER=false
MULTICA_WORKFLOW_DRIVER_INTERVAL=60s
MULTICA_WORKFLOW_DRIVER_CAPACITY_BACKOFF=60s
MULTICA_WORKFLOW_CONTROLLER_ID=replace-with-existing-controller-id

COLIMA_CPU=4
COLIMA_MEMORY_GIB=8
COLIMA_DISK_GIB=64
