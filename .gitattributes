# Ensure shell scripts always use LF line endings (needed for Docker on Windows)
*.sh text eol=lf
docker/entrypoint.sh text eol=lf

# Default behavior
* text=auto

# Qualification artifacts and the sources their freezes hash are pinned by
# SHA-256. A CRLF checkout changes their bytes and every integrity check fails
# closed, so keep these packages LF. The system graph role catalog is part of the same
# digest chain.
server/internal/agentqualification/** text eol=lf
server/internal/systemgraph/** text eol=lf

# Embedded skill bundles must have identical frontmatter and content bytes on
# Windows and Unix, including the legacy pointers shipped to older daemons.
server/internal/service/builtin_skills/** text eol=lf
server/internal/service/builtin_skills_legacy/** text eol=lf

# The complete local-shadow suite hashes these external source artifacts by
# exact byte content. Keep their checked-out representation identical to the
# canonical repository blobs on every host.
